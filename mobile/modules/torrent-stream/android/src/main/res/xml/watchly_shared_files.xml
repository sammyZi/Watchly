<?xml version="1.0" encoding="utf-8"?>
<!-- What "Open in…" may hand to another player: a finished download in the
     public Movies/Watchly (or the older Downloads/Watchly), and an episode
     still sitting in the torrent cache under the app's own external files.
     Each grant is for the one file named in the intent, read-only. -->
<paths>
  <external-path name="shared" path="." />
  <external-files-path name="cache" path="." />
  <!-- Only reached when the external volume is unavailable and downloads fall
       back to internal storage. -->
  <files-path name="internal" path="." />
</paths>
