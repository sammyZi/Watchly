<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AppCompat, not plain Material: the Cast device chooser is a dialog themed from the activity,
         and with no AppCompat colorPrimary it read #0 and crashed ("background can not be translucent"). -->
    <style name="Theme.Watchly" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#141414</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">#E50914</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- Android 12+ would put the app icon up first; black and empty, so the animated splash is the only one seen. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
    </style>
</resources>
