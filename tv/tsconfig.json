{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // src/lib imports carry the .ts extension so `node --experimental-strip-types`
    // can run the tests in there directly.
    "allowImportingTsExtensions": true,
    // Named explicitly: rooted at tv/, tsc does not pick @types/node up on its
    // own, and every src/lib test imports node:assert.
    "types": ["node", "react"]
  }
}
