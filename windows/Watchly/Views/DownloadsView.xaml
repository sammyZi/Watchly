<UserControl x:Class="Watchly.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Watchly.Controls"
             xmlns:e="clr-namespace:Watchly.Engine">
  <UserControl.Resources>
    <!-- One file in a season download: DownloadsScreen's queue row. -->
    <DataTemplate x:Key="QueueRow" DataType="{x:Type e:QueueFile}">
      <DockPanel Margin="0,6,18,6">
        <Border x:Name="Mark" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Control}">
          <TextBlock x:Name="Num" Text="{Binding Mark}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Faint}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Button DockPanel.Dock="Right" Style="{StaticResource Round}" Width="32" Height="32" Tag="16" Background="Transparent"
                Click="OnQueueAction" ToolTip="{Binding State}">
          <c:Icon x:Name="ActionIcon" Kind="x" Size="16" Foreground="{DynamicResource Faint}" />
        </Button>
        <StackPanel Margin="12,0" VerticalAlignment="Center">
          <TextBlock x:Name="Name" Text="{Binding Title}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
          <DockPanel Margin="0,4,0,0" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0:0}%}" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Accent}" Margin="8,0,0,0" MinWidth="34" TextAlignment="Right" />
            <ProgressBar Style="{StaticResource Bar}" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Faint}"
                     Visibility="{Binding IsActive, Converter={StaticResource Vis}, ConverterParameter=invert}" />
        </StackPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="Mark" Property="Background" Value="{DynamicResource GoodSoft}" />
          <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Good}" />
          <Setter TargetName="ActionIcon" Property="Kind" Value="play" />
          <Setter TargetName="ActionIcon" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOff}" Value="True">
          <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Faint}" />
          <Setter TargetName="ActionIcon" Property="Kind" Value="plus" />
          <Setter TargetName="ActionIcon" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The live card: artwork, stage, progress, swarm, controls, queue. -->
    <DataTemplate x:Key="ActiveCard" DataType="{x:Type e:ActiveDownload}">
      <Border CornerRadius="10" Background="{DynamicResource Surface}" Padding="16" Margin="0,0,14,14" VerticalAlignment="Top">
        <StackPanel>
          <DockPanel>
            <Grid DockPanel.Dock="Left" Width="84" Height="126">
              <Border CornerRadius="6" Background="{Binding Headline, Converter={StaticResource Hue}}" />
              <Border CornerRadius="6">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Poster, Converter={StaticResource Img}, ConverterParameter=168}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Grid>
            <StackPanel Margin="16,2,0,0" VerticalAlignment="Top">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Counts}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Accent}" Margin="8,3,0,0" />
                <TextBlock Text="{Binding Headline}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Headline}" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <ContentControl Style="{StaticResource Spinner}" Width="13" Height="13" Margin="0,0,8,0"
                                Visibility="{Binding Starting, Converter={StaticResource Vis}}" />
                <TextBlock x:Name="Stage" Text="{Binding Stage}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Accent}" />
              </StackPanel>

              <DockPanel Margin="0,14,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Overall, StringFormat={}{0:0}%}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" Margin="12,0,0,0" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                <ProgressBar Style="{StaticResource Bar}" Height="6" Value="{Binding Overall, Mode=OneWay}" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding EtaLine}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding SizeLine}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Text="{Binding SwarmLine}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,4,0,0"
                         Visibility="{Binding SwarmLine, Converter={StaticResource Vis}}" />
            </StackPanel>
          </DockPanel>

          <!-- What went wrong, where it can be fixed. -->
          <Border CornerRadius="6" Background="{DynamicResource DangerSoft}" Padding="12,10" Margin="0,14,0,0"
                  Visibility="{Binding HasError, Converter={StaticResource Vis}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Height="32" Tag="16" Click="OnChangeFolder" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Kind="folder" Size="13" Foreground="{DynamicResource Muted}" />
                  <TextBlock Text="Change folder" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
              <c:Icon DockPanel.Dock="Left" Kind="x" Size="14" Foreground="{DynamicResource Danger}" VerticalAlignment="Top" Margin="0,1,8,0" />
              <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="8" />
              <ColumnDefinition />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Pill}" Click="OnPauseResume">
              <StackPanel Orientation="Horizontal">
                <c:Icon x:Name="PauseIcon" Kind="pause" Size="15" Foreground="{DynamicResource Muted}" />
                <TextBlock x:Name="PauseText" Text="Pause" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Pill}" Click="OnStop">
              <StackPanel Orientation="Horizontal">
                <c:Icon Kind="x" Size="15" Foreground="{DynamicResource Muted}" />
                <TextBlock Text="Stop" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Round}" Background="{DynamicResource Control}" Click="OnOpenFolder" ToolTip="Show in folder">
              <c:Icon Kind="folder" Size="16" Foreground="{DynamicResource Muted}" />
            </Button>
          </Grid>

          <!-- The phone's per-download order: everything at once, or episode by episode. -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasQueue, Converter={StaticResource Vis}}">
            <ToggleButton Style="{StaticResource ChoiceChip}" Height="32" IsChecked="{Binding Fastest}" Content="Fastest"
                          ToolTip="Every file at once — done soonest overall" />
            <ToggleButton Style="{StaticResource ChoiceChip}" Height="32" IsChecked="{Binding OrderedChip}" Content="In order" Margin="8,0,0,0"
                          ToolTip="The next episode first, so you can start watching while the rest come" />
          </StackPanel>

          <StackPanel Visibility="{Binding HasQueue, Converter={StaticResource Vis}}">
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,0" />
            <ToggleButton Style="{StaticResource Bare}" IsChecked="{Binding QueueOpen}" Margin="0,10,0,4">
              <DockPanel>
                <c:Icon DockPanel.Dock="Right" x:Name="Chevron" Kind="chevron-up" Size="16" Foreground="{DynamicResource Faint}" />
                <TextBlock FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Faint}">
                  <Run Text="{Binding Queue.Count, Mode=OneWay}" /><Run Text=" FILES" />
                </TextBlock>
              </DockPanel>
            </ToggleButton>
            <!-- A season's episodes in as many columns as the card is wide. -->
            <ItemsControl ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueRow}" Focusable="False"
                          Visibility="{Binding QueueOpen, Converter={StaticResource Vis}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:ColumnWrap MinColumn="340" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Paused}" Value="True">
          <Setter TargetName="Stage" Property="Foreground" Value="{DynamicResource Muted}" />
          <Setter TargetName="PauseIcon" Property="Kind" Value="play" />
          <Setter TargetName="PauseText" Property="Text" Value="Resume" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasError}" Value="True">
          <Setter TargetName="Stage" Property="Foreground" Value="{DynamicResource Danger}" />
          <Setter TargetName="PauseIcon" Property="Kind" Value="rotate-cw" />
          <Setter TargetName="PauseText" Property="Text" Value="Retry" />
        </DataTrigger>
        <DataTrigger Binding="{Binding QueueOpen}" Value="False">
          <Setter TargetName="Chevron" Property="Kind" Value="chevron-down" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <DockPanel Margin="24,20,24,12">
      <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="6" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
        <c:Icon Kind="download" Size="17" Foreground="{DynamicResource Accent}" />
      </Border>
      <TextBlock Text="Downloads" Style="{StaticResource Display}" VerticalAlignment="Center" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,0,24,120">
        <!-- BitTorrent-style: paste a magnet or pick a .torrent and it downloads everything in it. -->
        <Border CornerRadius="8" Background="{DynamicResource Surface}" Padding="14,0,6,0" Height="50" Margin="0,4,0,10">
          <DockPanel>
            <c:Icon DockPanel.Dock="Left" Kind="link" Size="16" Foreground="{DynamicResource Faint}" Margin="0,0,12,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PillAccent}" Height="38" Tag="19" Content="Add" Click="OnAdd" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Height="38" Tag="19" Click="OnBrowse" ToolTip="Open a .torrent file">
              <StackPanel Orientation="Horizontal">
                <c:Icon Kind="file" Size="14" Foreground="{DynamicResource Muted}" />
                <TextBlock Text=".torrent" Margin="6,0,0,0" />
              </StackPanel>
            </Button>
            <TextBox x:Name="AddBox" Style="{StaticResource Field}" Tag="Paste a magnet link or .torrent URL to download it" KeyDown="OnAddKey" />
          </DockPanel>
        </Border>

        <!-- Where new downloads land, changeable right here as well as in Settings. -->
        <DockPanel Margin="4,0,0,18">
          <Button DockPanel.Dock="Right" Style="{StaticResource Bare}" Click="OnChangeFolder" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="Change" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
          </Button>
          <c:Icon DockPanel.Dock="Left" Kind="hard-drive" Size="13" Foreground="{DynamicResource Faint}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="FolderText" FontSize="12" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource ActiveCard}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:ColumnWrap MinColumn="560" FillRow="True" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock x:Name="SavedHeading" Text="SAVED" Style="{StaticResource Overline}" Margin="4,8,0,12" />
        <c:ColumnWrap x:Name="SavedList" MinColumn="480" />
        <ContentControl x:Name="EmptySlot" Focusable="False" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
