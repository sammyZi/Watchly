<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- src/theme.ts darkColors. WPF hex is #AARRGGBB, the phone's is #RRGGBBAA. -->
  <Color x:Key="BgColor">#000000</Color>
  <SolidColorBrush x:Key="Control" Color="#151922" />
  <SolidColorBrush x:Key="Bg" Color="#000000" />
  <SolidColorBrush x:Key="Surface" Color="#181d28" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#232936" />
  <SolidColorBrush x:Key="Line" Color="#2d3444" />
  <SolidColorBrush x:Key="Text" Color="#f3f5fa" />
  <SolidColorBrush x:Key="Muted" Color="#9aa4b8" />
  <SolidColorBrush x:Key="Faint" Color="#66718a" />
  <SolidColorBrush x:Key="Accent" Color="#d42f37" />
  <SolidColorBrush x:Key="AccentSoft" Color="#2a1216" />
  <SolidColorBrush x:Key="OnAccent" Color="#ffffff" />
  <SolidColorBrush x:Key="Danger" Color="#ff6b5e" />
  <SolidColorBrush x:Key="DangerSoft" Color="#2c1512" />
  <SolidColorBrush x:Key="Good" Color="#46d17f" />
  <SolidColorBrush x:Key="GoodSoft" Color="#10281b" />
  <SolidColorBrush x:Key="Warn" Color="#ffb340" />
  <SolidColorBrush x:Key="WarnSoft" Color="#2b2011" />
  <SolidColorBrush x:Key="Scrim" Color="#cc000000" />
  <SolidColorBrush x:Key="TabBar" Color="#d9181d28" />
  <LinearGradientBrush x:Key="FadeToBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#00000000" />
    <GradientStop Offset="0.45" Color="#40000000" />
    <GradientStop Offset="0.82" Color="#eb000000" />
    <GradientStop Offset="1" Color="#ff000000" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="FadeUp" StartPoint="0,1" EndPoint="0,0">
    <GradientStop Offset="0.2" Color="#ff000000" />
    <GradientStop Offset="1" Color="#00000000" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="FadeLeft" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#e6000000" />
    <GradientStop Offset="0.55" Color="#66000000" />
    <GradientStop Offset="1" Color="#00000000" />
  </LinearGradientBrush>
</ResourceDictionary>
