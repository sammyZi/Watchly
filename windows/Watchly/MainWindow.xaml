<Window x:Class="Watchly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Watchly.Controls"
        xmlns:local="clr-namespace:Watchly"
        Title="Watchly" Icon="pack://application:,,,/Assets/app.ico" Width="1280" Height="840" MinWidth="760" MinHeight="560"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource Noto}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static local:Cmd.OpenTitle}" Executed="OnOpenTitle" />
    <CommandBinding Command="{x:Static local:Cmd.OpenShelf}" Executed="OnOpenShelf" />
    <CommandBinding Command="{x:Static local:Cmd.PlayResume}" Executed="OnPlayResume" />
  </Window.CommandBindings>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <!-- The phone's NavRail on a wide screen (the TV's collapsed rail): the tabs down the
         left, the one you are on white with a red tick. -->
    <Border x:Name="TabDock" Width="76" Background="{DynamicResource TabBar}">
      <StackPanel x:Name="TabButtons" VerticalAlignment="Center" Margin="0,0,0,40" />
    </Border>

    <!-- Tabs: built on first visit, then kept and only hidden (App.tsx's TabPage). -->
    <Grid x:Name="Tabs" Grid.Column="1" />

    <!-- Pages drawn over the tabs: shelf grid, title page, file list. Last child is on top. -->
    <Grid x:Name="Layers" Grid.Column="1" />

    <ContentControl x:Name="PlayerHost" Grid.ColumnSpan="2" Focusable="False" Background="Black" Panel.ZIndex="100" Visibility="Collapsed" />

    <!-- A torrent being read — the swarm has to answer before anything can play. -->
    <Border x:Name="BusyCard" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,32"
            CornerRadius="10" Background="{DynamicResource SurfaceAlt}" Padding="16,10">
      <StackPanel Orientation="Horizontal">
        <ContentControl Style="{StaticResource Spinner}" Width="18" Height="18" />
        <TextBlock x:Name="BusyText" Text="Reading torrent…" Style="{StaticResource Label}" Margin="12,0,16,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource Bare}" Click="OnCancelOpen" VerticalAlignment="Center">
          <TextBlock Text="Cancel" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="13" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Home's offline note (mobile Home.kt). -->
    <Border x:Name="Offline" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0"
            CornerRadius="8" Background="{DynamicResource SurfaceAlt}" Padding="14,8" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal">
        <c:Icon Kind="wifi-off" Size="14" Foreground="{DynamicResource Muted}" />
        <TextBlock Text="You're offline — showing what was saved" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="Medium" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <!-- mobile App.kt Toast: a raised card at the foot, an alert mark in the accent. -->
    <Border x:Name="ToastBar" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,40"
            CornerRadius="10" Background="{DynamicResource SurfaceAlt}" Padding="16,12" MaxWidth="520" IsHitTestVisible="False">
      <DockPanel>
        <c:Icon x:Name="ToastIcon" DockPanel.Dock="Left" Kind="info" Size="20" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Top" />
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource Text}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- src/components/ConfirmModal.tsx -->
    <Grid x:Name="ConfirmLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Scrim}" MouseDown="OnConfirmBackdrop">
      <Border Width="360" CornerRadius="12" Background="{DynamicResource Surface}" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
              MouseDown="OnSwallow">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.25" Color="#0b1020" />
        </Border.Effect>
        <StackPanel>
          <Border x:Name="ConfirmBadge" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource DangerSoft}" Margin="0,0,0,16">
            <c:Icon x:Name="ConfirmIcon" Kind="trash-2" Size="20" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="ConfirmTitle" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource Text}" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock x:Name="ConfirmMessage" Style="{StaticResource Body}" TextAlignment="Center" Margin="0,8,0,0" />
          <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="12" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Pill}" Content="Cancel" Click="OnConfirmCancel" />
            <Button x:Name="ConfirmOk" Grid.Column="2" Style="{StaticResource PillDanger}" Content="Confirm" Click="OnConfirmOk" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
