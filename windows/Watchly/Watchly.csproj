<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Watchly</RootNamespace>
    <AssemblyName>Watchly</AssemblyName>
    <Version>2.4.0</Version>
    <Product>Watchly</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- assets/icon.png, the phone's launcher icon, at every size Windows asks for. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!--
    Published as a plain folder — Watchly.exe beside the runtime and libVLC — that the installer
    copies in whole. It used to be one self-extracting Watchly.exe (VLC loads its plugins only from
    disk), which unpacked ~250 MB to %TEMP%\.net\Watchly\ on the first launch of every build and
    again whenever Temp was cleaned: seconds before the window, and a 254 MB exe for antivirus to
    scan. AppContext.BaseDirectory is the install folder, where PlayerView finds libvlc\ and
    keeps VLC's plugin cache.
    ReadyToRun: the app's code and WPF's arrive compiled, rather than JIT-compiled on every start
    (~9 s of CPU at launch before).
  -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- The app is win-x64 only; the package ships x86 and arm64 VLC too. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!--
    Less of VLC than the package ships: playback needs none of these, and each is either
    something that reaches out on its own or code that parses what arrives from outside.
    Lua scripts fetch cover art and metadata from the web; UPnP/mDNS discovery scans the
    local network; the add-on repository and audio fingerprinter call videolan.org and
    AcoustID; stream_out, access_output and mux only send or record streams.
  -->
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.%2A;libvlccore.%2A;hrtfs\%2A%2A;plugins\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\lua\%2A%2A;plugins\services_discovery\%2A%2A;plugins\stream_out\%2A%2A;plugins\access_output\%2A%2A;plugins\mux\%2A%2A;plugins\misc\libaddonsvorepository_plugin.dll;plugins\misc\libaddonsfsstorage_plugin.dll;plugins\misc\libfingerprinter_plugin.dll" />
  </ItemGroup>

  <!--
    The SubDL key the phone app ships with (mobile/.env, since the phone moved into
    mobile/; a repo-root .env from before still works), baked in at build time the
    same way Expo inlines it — nothing to type, nothing stored. Missing .env just
    means online subtitle search is off. Either SUBDL_KEY or EXPO_PUBLIC_SUBDL_KEY.
  -->
  <PropertyGroup>
    <SubdlEnv Condition="Exists('..\..\mobile\.env')">$(MSBuildProjectDirectory)\..\..\mobile\.env</SubdlEnv>
    <SubdlEnv Condition="'$(SubdlEnv)' == '' And Exists('..\..\.env')">$(MSBuildProjectDirectory)\..\..\.env</SubdlEnv>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SubdlEnv)' != ''">
    <SubdlKey>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(SubdlEnv)')), '(?:EXPO_PUBLIC_)?SUBDL_KEY=(\S+)').Groups[1].Value)</SubdlKey>
    <SimklClientId>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(SubdlEnv)')), 'SIMKL_CLIENT_ID=(\S+)').Groups[1].Value)</SimklClientId>
    <MdblistClientId>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(SubdlEnv)')), 'MDBLIST_CLIENT_ID=(\S+)').Groups[1].Value)</MdblistClientId>
    <!-- AniList's client id, public as the phone's: its redirect is watchly://anilist, which the installer registers. -->
    <AnilistClientId>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(SubdlEnv)')), 'ANILIST_CLIENT_ID=(\S+)').Groups[1].Value)</AnilistClientId>
    <TmdbKey>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(SubdlEnv)')), 'TMDB_KEY=(\S+)').Groups[1].Value)</TmdbKey>
    <!-- The watch party relay (party/, a Cloudflare Worker); blank hides the feature. -->
    <PartyUrl>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(SubdlEnv)')), 'PARTY_URL=(\S+)').Groups[1].Value)</PartyUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PartyUrl" Value="$(PartyUrl)" />
    <AssemblyMetadata Include="SubdlKey" Value="$(SubdlKey)" />
    <AssemblyMetadata Include="SimklClientId" Value="$(SimklClientId)" />
    <AssemblyMetadata Include="MdblistClientId" Value="$(MdblistClientId)" />
    <AssemblyMetadata Include="AnilistClientId" Value="$(AnilistClientId)" />
    <AssemblyMetadata Include="TmdbKey" Value="$(TmdbKey)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Noto Sans is under the SIL Open Font License, which travels with the fonts. -->
    <Resource Include="Assets\Fonts\OFL.txt" />
    <Resource Include="Assets\app.ico" />
    <!-- The watch party's reactions in colour: WPF draws emoji fonts in black and white. Fluent Emoji, MIT (Assets\Reactions\LICENSE). -->
    <Resource Include="Assets\Reactions\*.png" />
    <!-- The profile faces, drawn from the same file as the phone's and the TV's. -->
    <EmbeddedResource Include="..\..\tv\core\src\main\resources\avatars.json" LogicalName="avatars.json" />
    <EmbeddedResource Include="..\..\tv\core\src\main\resources\watch-orders.json" LogicalName="watch-orders.json" />
    <EmbeddedResource Include="..\..\tv\core\src\main\resources\legal.json" LogicalName="legal.json" />
    <!-- Hand-drawn people, Open Peeps. CC0, see assets/people/LICENSE. -->
    <EmbeddedResource Include="..\..\tv\core\src\main\assets\people\*.png" LogicalName="people/%(Filename).png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

</Project>
