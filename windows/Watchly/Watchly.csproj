<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Watchly</RootNamespace>
    <AssemblyName>Watchly</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Watchly</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- assets/icon.png, the phone's launcher icon, at every size Windows asks for. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!--
    Publish as one Watchly.exe, libVLC included. VLC can only load its codec plugins
    from disk, so everything is unpacked on first launch to
    %TEMP%\.net\Watchly\<build id>\ (again only for a new build, or if Temp was
    cleaned) and the app runs from there — AppContext.BaseDirectory is that folder,
    which is where PlayerView looks for libvlc\ and writes VLC's plugin cache.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- The app is win-x64 only; the package ships x86 and arm64 VLC too. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!--
    Less of VLC than the package ships: playback needs none of these, and each is either
    something that reaches out on its own or code that parses what arrives from outside.
    Lua scripts fetch cover art and metadata from the web; UPnP/mDNS discovery scans the
    local network; the add-on repository and audio fingerprinter call videolan.org and
    AcoustID; stream_out, access_output and mux only send or record streams.
  -->
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.%2A;libvlccore.%2A;hrtfs\%2A%2A;plugins\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\lua\%2A%2A;plugins\services_discovery\%2A%2A;plugins\stream_out\%2A%2A;plugins\access_output\%2A%2A;plugins\mux\%2A%2A;plugins\misc\libaddonsvorepository_plugin.dll;plugins\misc\libaddonsfsstorage_plugin.dll;plugins\misc\libfingerprinter_plugin.dll" />
  </ItemGroup>

  <!--
    The SubDL key the phone app ships with (EXPO_PUBLIC_SUBDL_KEY in the repo's
    .env), baked in at build time the same way Expo inlines it — nothing to type,
    nothing stored. Missing .env just means online subtitle search is off.
  -->
  <PropertyGroup Condition="Exists('..\..\.env')">
    <SubdlKey>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\.env')), 'EXPO_PUBLIC_SUBDL_KEY=(\S+)').Groups[1].Value)</SubdlKey>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SubdlKey" Value="$(SubdlKey)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

</Project>
