<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same near-black as the Compose theme, so launch doesn't flash white. -->
    <style name="Theme.Reel" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="ink">#FF0B0B0E</color>
    <color name="accent">#FF3D8BFF</color>
</resources>
